{
  "name": "jun-portfolio-chat",
  "main": "index.mjs",
  "compatibility_date": "2026-10-25",
  "vars": {
    "ALLOWED_ORIGINS": "https://jspear01.github.io",
    "GROQ_MODEL": "llama-3.1-8b-instant"
  },
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": false }
}
